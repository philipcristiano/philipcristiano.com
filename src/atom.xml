---
layout: nil
---
<?xml version="1.0"?>
<feed xmlns="http://www.w3.org/2005/Atom">

  <title>philipcristiano.github.com</title>
  <link href="http://philipcristiano.github.com/"/>
  <link type="application/atom+xml" rel="self" href="http://writing.philipcristiano.com/atom.xml"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>http://writing.philipcristiano.com/</id>
  <author>
    <name>Philip Cristiano</name>
    <email>jekyll@philipcristiano.com</email>
  </author>

  {% for post in site.posts %}
  <entry>
    <id>http://writing.philipcristiano.com{{ post.id }}</id>
    <link type="text/html" rel="alternate" href="http://philipcristiano.github.com{{ post.url }}"/>
    <title>{{ post.title }}</title>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <author>
      <name>Philip Cristiano</name>
      <uri>http://philipcristiano.com</uri>
    </author>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}

</feed>

